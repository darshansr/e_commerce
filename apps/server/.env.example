# Copy to `.env` for local development:
#   cp apps/server/.env.example apps/server/.env
#
# The server has matching defaults baked into src/vendure-config.ts, so it will
# boot without this file. Set real values for anything non-local.

APP_ENV=dev
PORT=3000

# Auth
COOKIE_SECRET=dev-only-cookie-secret-change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Postgres (matches infrastructure/docker/docker-compose.yml)
# Host port is 5433 because a local Postgres often occupies 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=meghana
DB_PASSWORD=meghana
DB_DATABASE=meghana_pos

# Connection strings used by other tooling (listed in turbo.json globalEnv)
DATABASE_URL=postgresql://meghana:meghana@localhost:5433/meghana_pos
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev_master_key_change_me

# Vendure GraphQL endpoints (consumed by the storefront / gql.tada)
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api
VENDURE_ADMIN_API_URL=http://localhost:3000/admin-api
